{
  "name": "beets-web-import",
  "scripts": {
    "build:client": "esbuild src/client.ts --bundle --outfile=dist/client.js",
    "build:server": "esbuild src/server.ts --bundle --platform=node --outfile=dist/server.js --external:node-pty",
    "build": "mkdir -p dist && cp static/* dist/ && npm run build:client && npm run build:server"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "busboy": "^1.6.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
